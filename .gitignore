# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
client/dist/
server/dist/
# Packaged desktop builds. Also keeps editors and file watchers out: both index
# tracked files by default, and a held handle on dist/win-unpacked/resources/app.asar
# makes electron-builder fail with "cannot access the file" on the next build.
desktop/dist/
desktop/dist-build/

# Environment files
.env
.env.local
.env.*.local
!.env.example

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Prisma
server/prisma/migrations/

# Misc
*.tsbuildinfo
coverage/

# Exclude scripts directory
scripts/
Scripts/

# Exclude .md files inside Screenshots directory
[sS]creenshots/*.md
[sS]creenshots/**/*.md

