// NxtGen Academy — Prisma Schema
// Database: MariaDB/MySQL via Prisma ORM

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───

enum UserRole {
  ADMIN
  STUDENT
  SITE_USER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum OAuthProvider {
  GOOGLE
  GITHUB
}

enum BatchStatus {
  DRAFT
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum MaterialType {
  NOTES
  RECORDING
  ASSIGNMENT
  QUIZ
}

enum InquiryStatus {
  NEW
  CONTACTED
  CLOSED
}

enum InternshipType {
  GENERATIVE_AI
  AGENTIC_AI
}

enum SubscriptionPlan {
  FREE
  BASIC
  PRO
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum CourseCategory {
  AI
  DATABASE
}

enum TemplateCategory {
  FREE
  PREMIUM
}

enum AssistantCategory {
  BEHAVIORAL
  TECHNICAL
  SYSTEM_DESIGN
  GENERAL
}

enum MaterialRole {
  RESUME
  JOB_DESCRIPTION
  MATERIAL
}

enum SessionStatus {
  ACTIVE
  COMPLETED
  ABANDONED
}

// ─── Core Identity & Auth ───

model User {
  id                 String         @id @default(uuid())
  email              String         @unique
  passwordHash       String?
  firstName          String?
  lastName           String?
  phone              String?
  avatarUrl          String?
  role               UserRole       @default(SITE_USER)
  status             UserStatus     @default(ACTIVE)
  oauthProvider      OAuthProvider?
  mustChangePassword Boolean        @default(false)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  // Relations
  accounts         Account[]
  sessions         Session[]
  inviteTokens     UserInviteToken[]
  batchEnrollments BatchStudent[]
  progress         StudentProgress[]
  subscriptions    Subscription[]
  creditBalance    CreditBalance?
  toolUsageLogs    ToolUsageLog[]
  resumes          UserResume[]
  builderResumes   Resume[]
  certInquiries    CertificationInquiry[]
  auditLogs        AuditLog[]
  iAssistants      IAssistant[]
  iAssistSessions  IAssistSession[]
  contextDocuments ContextDocument[]
  desktopAuthCodes DesktopAuthCode[]

  @@index([email])
  @@index([role])
}

model Account {
  id                String        @id @default(uuid())
  userId            String
  provider          OAuthProvider
  providerAccountId String
  accessToken       String?       @db.Text
  refreshToken      String?       @db.Text
  expiresAt         Int?
  createdAt         DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  refreshToken String   @unique @db.VarChar(512)
  expiresAt    DateTime
  userAgent    String?  @db.VarChar(512)
  ipAddress    String?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserInviteToken {
  id        String    @id @default(uuid())
  userId    String
  token     String    @unique @db.VarChar(256)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

// ─── Academy & Learning ───

model Course {
  id             String         @id @default(uuid())
  title          String
  slug           String         @unique
  category       CourseCategory
  description    String         @db.Text
  shortDesc      String?        @db.VarChar(500)
  modules        Json? // Array of module objects
  thumbnail      String?
  duration       String?
  prerequisites  String?        @db.Text
  careerOutcomes String?        @db.Text
  isActive       Boolean        @default(true)
  sortOrder      Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  // Relations
  batches          Batch[]
  certifications   CourseCertification[]
  corporateCourses CorporateCourse[]

  @@index([category])
  @@index([slug])
}

model Batch {
  id           String      @id @default(uuid())
  name         String
  courseId      String
  startDate    DateTime
  endDate      DateTime    // Max date until which students have access
  maxStudents  Int         @default(30)
  driveFolder  String?     // Google Drive folder URL
  status       BatchStatus @default(DRAFT)
  /// Pre-launch webinar for prospects. Marketing-only; ignored by operations.
  webinarDate  DateTime?
  /// Whether this batch appears on the public /upcoming-batches page.
  isPublished  Boolean     @default(false)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  course    Course          @relation(fields: [courseId], references: [id])
  students  BatchStudent[]
  schedules ClassSchedule[]
  materials StudyMaterial[]

  @@index([courseId])
  @@index([status])
}

model BatchStudent {
  id         String   @id @default(uuid())
  batchId    String
  studentId  String
  enrolledAt DateTime @default(now())

  batch   Batch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  student User  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([batchId, studentId])
  @@index([batchId])
  @@index([studentId])
}

model ClassSchedule {
  id        String   @id @default(uuid())
  batchId   String
  title     String
  dateTime  DateTime
  zoomLink  String?
  duration  Int? // Duration in minutes
  status    String   @default("scheduled") // scheduled, completed, cancelled
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  batch Batch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId])
  @@index([dateTime])
}

model StudyMaterial {
  id          String       @id @default(uuid())
  batchId     String
  type        MaterialType
  title       String
  driveFileId String? // Google Drive File ID
  driveUrl    String? // Direct link
  description String?      @db.Text
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  batch Batch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId])
  @@index([createdAt(sort: Desc)])
}

model StudentProgress {
  id               String    @id @default(uuid())
  userId           String
  courseId         String
  completedModules Json? // Array of completed module IDs
  overallProgress  Float     @default(0) // Percentage
  assignmentScores Json?
  quizScores       Json?
  lastAccessedAt   DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
}

model Certification {
  id           String   @id @default(uuid())
  name         String
  provider     String?
  link         String?
  prerequisite String?  @db.Text
  isActive     Boolean  @default(true)
  ctaEnabled   Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  courses   CourseCertification[]
  inquiries CertificationInquiry[]
}

model CourseCertification {
  id              String @id @default(uuid())
  courseId        String
  certificationId String

  course        Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  certification Certification @relation(fields: [certificationId], references: [id], onDelete: Cascade)

  @@unique([courseId, certificationId])
}

model CertificationInquiry {
  id                String        @id @default(uuid())
  certificationId   String?
  certificationName String
  userId            String?
  userName          String
  userEmail         String
  userPhone         String?
  message           String?       @db.Text
  status            InquiryStatus @default(NEW)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  certification Certification? @relation(fields: [certificationId], references: [id])
  user          User?          @relation(fields: [userId], references: [id])

  @@index([status])
  @@index([createdAt(sort: Desc)])
}

model Internship {
  id                String         @id @default(uuid())
  title             String
  description       String         @db.Text
  programType       InternshipType
  duration          String // e.g., "12 Weeks"
  eligibility       String?        @db.Text
  learningOutcomes  Json? // Array of outcome strings
  projectHighlights Json? // Array of project highlight objects
  isActive          Boolean        @default(true)
  applicationLink   String?
  startDate         DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
}

// ─── Corporate & Upcoming ───

model UpcomingBatch {
  id          String    @id @default(uuid())
  courseName  String
  startDate   DateTime
  webinarDate DateTime?
  description String?   @db.Text
  isPublished Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model CorporateCourse {
  id                String  @id @default(uuid())
  courseId          String
  customDescription String? @db.Text
  targetAudience    String?
  isActive          Boolean @default(true)
  sortOrder         Int     @default(0)

  course Course @relation(fields: [courseId], references: [id])

  @@index([courseId])
}

// ─── Subscription & Credits ───

model Subscription {
  id        String             @id @default(uuid())
  userId    String
  plan      SubscriptionPlan   @default(FREE)
  status    SubscriptionStatus @default(ACTIVE)
  startDate DateTime           @default(now())
  endDate   DateTime?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model CreditBalance {
  id           String    @id @default(uuid())
  userId       String    @unique
  totalCredits Int       @default(0)
  usedCredits  Int       @default(0)
  lastRecharge DateTime?
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ToolUsageLog {
  id              String   @id @default(uuid())
  userId          String
  toolName        String
  inputSummary    String?  @db.Text
  outputSummary   String?  @db.Text
  creditsConsumed Int      @default(0)
  durationMs      Int?
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([toolName])
  @@index([createdAt(sort: Desc)])
}

// ─── Resume Templates & User Resumes ───

model ResumeTemplate {
  id           String           @id @default(uuid())
  name         String
  category     TemplateCategory @default(FREE)
  htmlTemplate String           @db.LongText
  cssStyles    String?          @db.LongText
  thumbnail    String?
  isActive     Boolean          @default(true)
  sortOrder    Int              @default(0)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  resumes UserResume[]
}

model UserResume {
  id           String   @id @default(uuid())
  userId       String
  templateId   String?
  title        String   @default("Untitled Resume")
  resumeData   Json // Full resume JSON data
  lastModified DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  template ResumeTemplate? @relation(fields: [templateId], references: [id])

  @@index([userId])
}

// ─── Admin Configuration ───

model MenuItem {
  id        String   @id @default(uuid())
  label     String
  href      String
  parentId  String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  icon      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
  @@index([sortOrder])
}

model HeroBanner {
  id        String   @id @default(uuid())
  title     String
  subtitle  String?
  imageUrl  String?
  ctaText   String?
  ctaLink   String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
}

model SiteConfig {
  id    String @id @default(uuid())
  key   String @unique
  value String @db.Text

  @@index([key])
}

model AuditLog {
  id          String   @id @default(uuid())
  userId      String?
  action      String
  targetModel String?
  targetId    String?
  payload     Json?
  ipAddress   String?
  timestamp   DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([timestamp(sort: Desc)])
  @@index([action])
}

// ─── Resume Builder (ported from MindSync) ───
// `data` holds the full resume JSON; `template` is a code-defined template id
// from client/src/lib/resumeTemplates.ts, not a ResumeTemplate row.

model Resume {
  id            String          @id @default(uuid())
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String
  template      String          @default("classic")
  data          String          @db.LongText
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  versions      ResumeVersion[]
  coverLetter   CoverLetter?
  interviewPrep InterviewPrep?

  @@index([userId])
  @@map("resumes")
}

model ResumeVersion {
  id         String   @id @default(uuid())
  resumeId   String
  resume     Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  role       String
  company    String
  template   String   @default("classic")
  data       String   @db.LongText
  ats        Int      @default(0)
  jdText     String?  @db.LongText
  jdKeywords String?  @db.Text // JSON-encoded string[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([resumeId])
  @@map("resume_versions")
}

model CoverLetter {
  id        String   @id @default(uuid())
  resumeId  String   @unique
  resume    Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  company   String   @default("")
  role      String   @default("")
  manager   String   @default("")
  tone      String   @default("professional")
  jd        String   @db.LongText
  body      String   @db.LongText
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("cover_letters")
}

model InterviewPrep {
  id        String   @id @default(uuid())
  resumeId  String   @unique
  resume    Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  role      String   @default("")
  jd        String   @db.LongText
  questions String   @db.LongText
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("interview_preps")
}

/// Internship applications, including the applicant's CV.
/// The file is stored in-row as bytes: at résumé sizes (~200KB) this is well
/// within MySQL's comfort zone and avoids a hard dependency on object storage.
/// Swap `fileData` for an S3 key later without touching the rest of the flow.
model InternshipApplication {
  id            String   @id @default(uuid())
  internshipId  String?
  programTitle  String
  fullName      String
  email         String
  phone         String
  resumeFileName String?
  resumeMimeType String?
  fileData      Bytes?   @db.LongBlob
  status        String   @default("NEW")
  createdAt     DateTime @default(now())

  @@index([internshipId])
  @@index([createdAt(sort: Desc)])
}

// ─── I-Assist (Interview Assistant) ───

model IAssistant {
  id              String            @id @default(uuid())
  userId          String
  name            String
  category        AssistantCategory @default(GENERAL)
  targetRole      String?
  experienceYears Int?
  instructions    String?           @db.Text
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  materials AssistantMaterial[]
  sessions  IAssistSession[]

  @@index([userId])
}

model AssistantMaterial {
  id          String       @id @default(uuid())
  assistantId String
  documentId  String?
  role        MaterialRole
  title       String
  content     String?      @db.Text
  createdAt   DateTime     @default(now())

  assistant IAssistant       @relation(fields: [assistantId], references: [id], onDelete: Cascade)
  document  ContextDocument? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([assistantId])
  @@index([documentId])
}

model ContextDocument {
  id          String   @id @default(uuid())
  userId      String
  title       String
  description String?
  fileName    String?
  fileType    String?
  fileSize    Int?
  content     String   @db.LongText
  wordCount   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  materials AssistantMaterial[]

  @@index([userId])
}

model IAssistSession {
  id                String        @id @default(uuid())
  userId            String
  assistantId       String?
  // Snapshotted at creation. assistantId is SetNull on delete, so without these
  // a deleted assistant silently erases the attribution of every past session.
  assistantName     String?
  assistantCategory AssistantCategory?
  status            SessionStatus @default(ACTIVE)
  platform          String        @default("desktop")
  startedAt         DateTime      @default(now())
  endedAt           DateTime?
  durationSeconds   Int?
  questionsAnswered Int           @default(0)
  tokensUsed        Int           @default(0)
  createdAt         DateTime      @default(now())

  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  assistant   IAssistant?         @relation(fields: [assistantId], references: [id], onDelete: SetNull)
  transcripts SessionTranscript[]

  @@index([userId])
  @@index([assistantId])
  @@index([status, startedAt])
}

model SessionTranscript {
  id         String   @id @default(uuid())
  sessionId  String
  speaker    String
  text       String   @db.Text
  isQuestion Boolean  @default(false)
  response   String?  @db.Text
  tokens     Int      @default(0)
  timestamp  Int      @default(0)
  createdAt  DateTime @default(now())

  session IAssistSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model DesktopAuthCode {
  id        String   @id @default(uuid())
  code      String   @unique
  state     String
  userId    String
  used      Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([code])
  @@index([userId])
}
