# ─── Server Environment Variables ───
# Copy this file to .env and fill in your values

# Database
DATABASE_URL="mysql://root:admin@localhost:3306/nxtgen_academy"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_REFRESH_SECRET="your-refresh-secret-change-in-production"
JWT_EXPIRES_IN="30m"
JWT_REFRESH_EXPIRES_IN="30d"

# Server
PORT=3001
NODE_ENV=development
CLIENT_URL="http://localhost:5173"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# GitHub OAuth
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"

# Resend Email
RESEND_API_KEY="your-resend-api-key"
FROM_EMAIL="noreply@nxtgen.pavy.ai"

# Gemini AI
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_PRIMARY_MODEL="gemini-1.5-flash"
GEMINI_FALLBACK_MODEL="gemini-1.5-pro"
GEMINI_VOICE_MODEL="gemini-2.0-flash-exp"

# S3 / Cloudflare R2 Storage
S3_ENDPOINT="https://your-account.r2.cloudflarestorage.com"
S3_ACCESS_KEY_ID="your-access-key"
S3_SECRET_ACCESS_KEY="your-secret-key"
S3_BUCKET_NAME="nxtgen-academy"
S3_REGION="auto"

# Redis (for BullMQ)
REDIS_URL="redis://localhost:6379"

# Resume Builder AI (ported from MindSync)
RESUME_AI_PROVIDER=mock
RESUME_AI_MODEL=gemini-2.5-pro
RESUME_AI_MODEL_FAST=gemini-2.5-flash

# AI task queue (in-memory unless REDIS_URL is set)
AI_QUEUE_CONCURRENCY=4
AI_QUEUE_ATTEMPTS=3
AI_QUEUE_BACKOFF_MS=800
# REDIS_URL=redis://localhost:6379

# Stopgap while there is no payment provider: the Upgrade button grants the
# plan directly, with no money taken. Set to false as soon as checkout exists.
# ── Payments ──────────────────────────────────────────────
# Stripe handles every market except India (Cashfree is next phase).
# Leave blank to disable card payments; checkout then answers 503.
STRIPE_SECRET_KEY=
# From `stripe listen` locally, or the endpoint's signing secret in the
# dashboard. Without it, webhooks are rejected — an unsigned callback is
# indistinguishable from anyone who found the URL.
STRIPE_WEBHOOK_SECRET=

# Cashfree handles India (UPI, netbanking, RuPay). The client secret also
# signs webhooks, so there is no separate webhook secret.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox
# Cashfree posts webhooks to an absolute URL, so localhost will not work in
# development — use a tunnel (ngrok/cloudflared) and put its origin here.
SERVER_PUBLIC_URL=
